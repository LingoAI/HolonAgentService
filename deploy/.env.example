# Server runtime only. Buyer and deployer keys stay on the operator's machine.
HIRE_NETWORK=xlayer-testnet
XLAYER_RPC_URL=https://testrpc.xlayer.tech/terigon
HOLON_PUBLIC_URL=
HOLON_INDEX_ON_BOOT=0

# Required by the MVP. Deploy the new escrow before selecting this immutable record.
MVP_DEPLOYMENT_MANIFEST=xlayer-testnet-mvp.json
MVP_PUBLIC_ORIGIN=https://marketplace.example.com
MVP_IPFS_GATEWAYS=https://ipfs.io/ipfs/,https://dweb.link/ipfs/
MVP_MAINNET_CANARY=0
MVP_RETENTION_UNTIL=2026-10-31

# Legacy x402 runtime only. The MVP task flow never uses these keys and the
# public platform-provider execution endpoint is disabled; leave blank unless
# separately maintaining the historical x402 demo.
AGENT_PROVIDER_PRIVATE_KEY=
FACILITATOR_PRIVATE_KEY=

# Omit on testnet to deploy dUSD (no monetary value). Mainnet requires a compatible EIP-3009 token.
PAYMENT_TOKEN_ADDRESS=
PAYMENT_TOKEN_NAME=
PAYMENT_TOKEN_VERSION=
X402_PRICE=0.01
PROTOCOL_PORT=9402
PORT=8765

# Optional authentication for all /api/* routes. Buyer scripts must pass the same token when enabled.
HOLON_TOKEN=
HOLON_READONLY=0
ANONYMIZED_TELEMETRY=False

# DNS hostname for HTTPS, or http://43.98.161.223 for the initial IP endpoint.
MARKETPLACE_DOMAIN=marketplace.example.com
