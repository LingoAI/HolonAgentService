# Copy to .env for a public X Layer deployment. scripts/dev-local.mjs sets its own local profile.
HIRE_NETWORK=xlayer-testnet
XLAYER_RPC_URL=https://testrpc.xlayer.tech/terigon
HOLON_PUBLIC_URL=
HOLON_INDEX_ON_BOOT=0

# Dedicated wallets. Public deployments never use the Hardhat test mnemonic.
DEPLOYER_PRIVATE_KEY=
BUYER_PRIVATE_KEY=
AGENT_PROVIDER_PRIVATE_KEY=
FACILITATOR_PRIVATE_KEY=

# Omit on testnet to deploy dUSD (no monetary value). Mainnet requires a compatible EIP-3009 token.
PAYMENT_TOKEN_ADDRESS=
PAYMENT_TOKEN_NAME=
PAYMENT_TOKEN_VERSION=
# Required only for the deliberately capped X Layer mainnet canary profile.
MVP_MAINNET_CANARY=0
MVP_DEPLOYMENT_MANIFEST=xlayer-testnet-mvp.json
MVP_PUBLIC_ORIGIN=
MVP_RETENTION_UNTIL=2026-10-31
X402_PRICE=0.01
PROTOCOL_PORT=9402
PORT=8765

# Optional authentication for all /api/* routes. Buyer scripts must pass the same token when enabled.
HOLON_TOKEN=
HOLON_READONLY=0
ANONYMIZED_TELEMETRY=False
